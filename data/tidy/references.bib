@article{baldanti_emergence_2002,
	title = {Emergence of multiple drug-resistant human cytomegalovirus variants in 2 patients with human immunodeficiency virus infection unresponsive to highly active antiretroviral therapy},
	volume = {34},
	doi = {10.1086/339750},
	abstract = {In 2 patients infected with human immunodeficiency virus ({HIV}), highly active antiretroviral therapy was unable to suppress {HIV} replication as a result of the emergence of drug-resistant {HIV} variants. Human cytomegalovirus ({HCMV}) retinitis developed in both patients, and an unusually complex mixture of drug-resistant {HCMV} variants was detected in both patients.},
