@article{koay_novel_2010,
	title = {Novel mutations in cytomegalovirus {UL}54 and {UL}97 genes related to the use of antiviral drugs},
	volume = {12},
	abstract = {Introduction: The development of antiviral drug resistance is a serious concern in clinical situations where patients are exposed to such drugs for prolonged periods. One example of this is in immunocompromised transplant patients with reactivated or primary cytomegalovirus ({CMV}) infection necessitating the prolonged use of ganciclovir and/or foscarnet, and/or cidofovir. At the National University Hospital (Singapore), {CMV} drug resistance ({DR}) assays are run routinely. Several novel {UL}54 and {UL}97 mutations that are found repeatedly in {CMV} from patients on prolonged anti-{CMV} therapy are reported here. Methods: An in-house sequencing method was designed to cover the regions in the {UL}54 ({DNA} polymerase) and {UL}97 (phosphotransferase) genes in {CMV} within which the most frequent {DR}-associated mutations arise. Briefly, viral {DNA} extracted is amplified using gene-specific primer sets and nested {PCR}. After gel electrophoretic separation, 5 appropriately-sized bands are excised and purified (Qiagen {QIAquick} {PCR} purification kit), prior to {DNA} sequencing ({ABI} 3130 Prism genetic analyzer). Sequences obtained are checked against reference wild-type {UL}97 and {UL}54 gene database ({NCBI} Blast) for mutations; known mutations found are correlated to ganciclovir/foscarnet/cidofovir drug resistance. Results: Out of 106 cases that were successfully sequenced since 06/2004, we found 80 with several hitherto unreported {CMV} mutations that occurred repeatedly: in {UL}54: N685S (70/106=66\%), A688V (45/106=42.5\%), T691A (9/106=8.5\%), with each of R765C, R769C and T494I being present in 1/106=1\% of cases. Interestingly, every case with A688V occurred with N685S. Where N685S did not occur with A688V, it either occurred alone or with T691A. In {UL}97, D605E (28/106=26.4\%) occurred most frequently, usually alone or together with known {DR} mutations such as A594V (3 cases) and T412S (1 of the cases with A594V). Conclusions: Further in vitro, phenotyping (viral culture) testing of {CMVs} containing these mutations is required to ascertain their true status as novel anti-{CMV} {DR} strains. However, the frequent occurrence of these mutations, particularly N685S, A688V and T691A (as defined by comparison to the reference {CMV} Towne strain) in these patients suggest that either these are indeed novel anti-{CMV} {DR} mutations or that they are polymorphisms unique to the latent {CMV} found in this local population.},
	pages = {879},
	number = {6},
	journaltitle = {Journal of Molecular Diagnostics},
	shortjournal = {Journal of Molecular Diagnostics},
	author = {Koay, E.S. and Huan, P. and Tang, J.W.},
	date = {2010},
}

@article{koepf_us_suppression_2020,
	title = {Suppression of {CMV} Infection with Letermovir in a Kidney Transplant Patient.},
	volume = {7},
	doi = {10.12890/2020_001622},
	abstract = {Infection with cytomegalovirus ({CMV}) with resistance to ganciclovir ({GCV}) is a therapeutic challenge in kidney transplant patients, because standard treatment options are nephrotoxic. We report the case of a kidney transplant recipient with {GCV}-resistant {CMV} disease, in whom letermovir, a novel inhibitor of {CMV} packaging, was administered off-label and prevented a relapse of disease once the {CMV} load was decreased by cidofovir. Furthermore, we observed significant drug interactions between letermovir and tacrolimus. {LEARNING} {POINTS}: Cytomegalovirus ({CMV}) disease with resistance to ganciclovir ({GCV}) is difficult to manage in transplant patients.Letermovir may become a new option for treatment and prophylaxis of {GCV}-resistant {CMV} infection, but assessment of treatment response is difficult.Letermovir may lead to drug interactions via {CYP}3A4.},
	pages = {001622},
	number = {7},
	journaltitle = {Eur J Case Rep Intern Med},
	shortjournal = {Eur J Case Rep Intern Med},
	author = {{Koepf US} and {Klehr HU} and {Eis-Huebinger AM} and {Aldabbagh S} and {Strassburg CP} and {Boes D} and {Lutz P}},
	date = {2020},
	note = {Place: Italy},
}

